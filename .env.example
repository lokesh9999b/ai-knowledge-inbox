# LLM (Groq, OpenAI-compatible). Without a key the app falls back to extractive answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "local" (transformers.js MiniLM, downloads ~25MB once) or "hash" (offline, deterministic, lower quality)
EMBEDDER=local

PORT=3001
DB_PATH=./data/inbox.db
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Per-IP requests per minute on /ingest and /query (0 disables; only for load tests)
RATE_LIMIT_PER_MINUTE=60

# Worker threads for the local embedding model (0 = run it on the main thread)
EMBED_WORKERS=1

# LLM resilience: backup Groq model, per-attempt timeout and one overall deadline for the whole LLM step
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=6000
LLM_DEADLINE_MS=10000
# Optional extra provider (any OpenAI-compatible API, e.g. Hugging Face https://router.huggingface.co/v1). Set all three.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
