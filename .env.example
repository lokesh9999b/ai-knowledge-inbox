# LLM chain, tried in this order: OpenAI (main) -> Groq -> optional extra provider -> best matching saved passage.
# Every key is optional. Providers without a key are skipped; with none at all the app still answers (extractively).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Azure OpenAI or an OpenAI-compatible gateway
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "local" (transformers.js MiniLM, downloads ~25MB once) or "hash" (offline, deterministic, lower quality)
EMBEDDER=local

PORT=3001
DB_PATH=./data/inbox.db
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Per-IP requests per minute on /ingest and /query (0 disables; only for load tests)
RATE_LIMIT_PER_MINUTE=60

# Worker threads for the local embedding model (0 = run it on the main thread)
EMBED_WORKERS=1

# LLM resilience: backup Groq model, per-attempt timeout and one overall deadline for the whole LLM step
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=6000
LLM_DEADLINE_MS=10000
# Optional extra provider (any OpenAI-compatible API, e.g. Hugging Face https://router.huggingface.co/v1). Set all three.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Where the embedding model files are cached (the Docker image bakes them into /models). Unset = library default.
# MODEL_CACHE_DIR=
